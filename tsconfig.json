{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/index.ts",
    "src/commands/**/*",
    "src/config/**/*",
    "src/handlers/**/*",
    "src/repository/KeysRepository.ts",
    "src/repository/supabase.ts",
    "src/repository/TerritoryRepository.ts",
    "src/services/**/*",
    "src/types/**/*",
    "src/utils/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
